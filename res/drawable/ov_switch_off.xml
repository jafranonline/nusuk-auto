<?xml version="1.0" encoding="utf-8"?>
<!-- Mini switch, OFF: outlined track, thumb left -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1E3A5C" />
            <corners android:radius="9dp" />
            <stroke android:width="1dp" android:color="#4F7FAE" />
        </shape>
    </item>
    <item android:width="12dp" android:height="12dp" android:gravity="start|center_vertical" android:start="3dp">
        <shape android:shape="oval">
            <solid android:color="#8FA9C4" />
        </shape>
    </item>
</layer-list>
